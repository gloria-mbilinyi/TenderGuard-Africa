## Copy to .env on the EC2 host. Never commit the populated file.
TENDERGUARD_DOMAIN=tenderguard.example.org
TENDERGUARD_TLS_EMAIL=operator@example.org

## Generate both values privately on the host. Do not reuse real account passwords.
TENDERGUARD_API_KEY=
TENDERGUARD_DASHBOARD_PASSWORD=

TENDERGUARD_OLLAMA_MODEL=qwen3:1.7b
TENDERGUARD_MAX_PDF_MB=10
TENDERGUARD_MAX_PDF_PAGES=80

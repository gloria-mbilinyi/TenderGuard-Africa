## Required: generate a private value before starting TenderGuard.
TENDERGUARD_API_KEY=

## Required for browser sign-in; never expose this through VITE_* variables.
TENDERGUARD_DASHBOARD_PASSWORD=

## Set true only when the dashboard is served over HTTPS.
TENDERGUARD_COOKIE_SECURE=false

## Optional comma-separated allowlist for browser POST origins.
## The secure defaults cover localhost ports 5173 and 8000.
# TENDERGUARD_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8000

## Hosted deployments must set the exact HTTPS origin and enable secure cookies.
## Example only; do not use this placeholder as an actual deployment value.
# TENDERGUARD_ALLOWED_ORIGINS=https://tenderguard.example.org

## Uploaded PDFs are stored outside source code. Docker overrides this to /app/storage.
# TENDERGUARD_DOCUMENT_STORAGE=storage/document_evaluations
TENDERGUARD_MAX_PDF_MB=10
TENDERGUARD_MAX_PDF_PAGES=80

## API is published to localhost only by default. Do not use 0.0.0.0 casually.
TENDERGUARD_BIND_ADDRESS=127.0.0.1
TENDERGUARD_PORT=8000

## Option A (default): Ollama runs on the host computer.
TENDERGUARD_OLLAMA_URL=http://host.docker.internal:11434/api/chat

## Option B: set this to http://ollama:11434/api/chat and start the ollama profile.
TENDERGUARD_OLLAMA_MODEL=qwen3:1.7b
